    "aula:local": "node scripts/classroom-server.mjs",
    "build:pages": "node build-offline.mjs",
    "preview:pages": "node scripts/preview-static.mjs",
    "test:browser": "node tests/verify-browser.mjs",
    "check": "tsc --noEmit && node tests/verify-challenges.mjs && node tests/verify-display-options.mjs && node tests/verify-3d.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.159.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
